# Caddy reverse proxy for Sicilius on Oracle VPS
# Domain is set to sslip.io for the server's public IP

sicilius.com.tr, *.sicilius.com.tr {
  encode zstd gzip
  tls /etc/caddy/certs/sicilius-origin.crt /etc/caddy/certs/sicilius-origin.key
  log {
    output stdout
    format json
  }


  # Backend API
  @api path /api*
  handle @api {
    reverse_proxy backend:5001
  }

  # Backend misc endpoints (health, docs)
  @backend_misc path /health /docs
  handle @backend_misc {
    reverse_proxy backend:5001
  }

  # Frontend default
  handle {
    reverse_proxy frontend:3000
  }
}
