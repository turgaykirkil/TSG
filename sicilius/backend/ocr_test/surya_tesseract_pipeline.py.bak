def parse_structured_text(text):
    """
    Sütunlara ayrılmış metni önce ilan bloklarına ayırır, sonra her bloktan yapısal veri çıkarır.
    """
    # Metni, her bir ilanın başlangıcını gösteren başlığa göre böl.
    announcement_blocks = re.split(r'(?=T\.C\..*?TİCARET SİCİLİ MÜDÜRLÜĞÜ\'NDEN)', text)

    parsed_announcements = []
    for block in announcement_blocks:
        # Sadece anlamlı görünen, 'Ticaret Unvani' gibi bir anahtar kelime içeren blokları işle
        if not block.strip() or 'Ticaret Unvani' not in block:
            continue

        data = {}
        
        # Ticaret Unvanı: 'Ticaret Unvani:' ile başlar ve 'Adres:', 'Mersis No:' veya 'Yukarıda Bilgileri' gibi bir sonraki belirteçe kadar devam eder.
        ticaret_unvani_match = re.search(r'Ticaret Unvani:\s*([\s\S]*?)(?=Adres:|Mersis No:|Yukarıda Bilgileri Verilen|$)', block, re.IGNORECASE)
        if ticaret_unvani_match:
            # HTML tag'lerini ve fazla boşlukları temizle
            unvan = re.sub('<[^<]+?>', '', ticaret_unvani_match.group(1))
            data['ticaret_unvani'] = ' '.join(unvan.split()).strip()
        else:
            data['ticaret_unvani'] = None

        sicil_no_match = re.search(r'Ticaret Sicil(?:/|\s*)Dosya No:\s*(\d+)', block, re.IGNORECASE)
        data['sicil_no'] = sicil_no_match.group(1).strip() if sicil_no_match else None
        
        mersis_no_match = re.search(r'Mersis No:\s*(\d+)', block, re.IGNORECASE)
        data['mersis_no'] = mersis_no_match.group(1).strip() if mersis_no_match else None

        # Ham blok metnini de ekle
        data['raw_block_text'] = block.strip()
        
        # Sadece içinde ayrıştırılmış veri olan blokları ekle (en azından unvan olmalı)
        if data.get('ticaret_unvani'):
            parsed_announcements.append(data)
    
    return parsed_announcements

def reorder_text_by_columns(text_lines):
    """
    Surya'dan gelen metin satırlarını, sütun düzenini dikkate alarak yeniden sıralar.
    Metinleri önce sütunlara ayırır, sonra her sütunu dikey olarak okur.
    """
    if not text_lines:
        return ""

    # Basit bir tepe bulma fonksiyonu
    def find_peaks_simple(data, height=1):
        peaks = []
        if len(data) <= 1:
            return peaks
        # Kenarları kontrol et
        if data[0] > data[1] and data[0] >= height:
            peaks.append(0)
        for i in range(1, len(data) - 1):
            if data[i] > data[i-1] and data[i] > data[i+1] and data[i] >= height:
                peaks.append(i)
        if data[-1] > data[-2] and data[-1] >= height:
            peaks.append(len(data)-1)
        return peaks

    # Metin kutularının merkez x koordinatlarını al
    x_centers = [(line.bbox[0] + line.bbox[2]) / 2 for line in text_lines]
    
    # Sütunları bulmak için histogram kullan. Bin sayısını satır sayısına göre ayarla.
    num_bins = max(10, int(len(x_centers) / 4))
    counts, bin_edges = np.histogram(x_centers, bins=num_bins)
    
    # Histogramdaki tepeleri (sütun merkezlerini) bul
    peaks = find_peaks_simple(counts, height=1)

    if not peaks:
        # Tepe bulunamazsa, tüm metni tek sütun olarak kabul et
        sorted_lines = sorted(text_lines, key=lambda line: line.bbox[1])
        return "\n".join([line.text for line in sorted_lines])

    column_centers = [(bin_edges[p] + bin_edges[p+1]) / 2 for p in peaks]

    # Metin satırlarını en yakın sütun merkezine ata
    columns = {center: [] for center in column_centers}
    for line in text_lines:
        center_x = (line.bbox[0] + line.bbox[2]) / 2
        closest_column = min(column_centers, key=lambda c: abs(c - center_x))
        columns[closest_column].append(line)

    # Sütunları soldan sağa sırala
    sorted_column_centers = sorted(columns.keys())

    full_text = []
    for center in sorted_column_centers:
        # Sütun içindeki satırları yukarıdan aşağıya sırala
        sorted_lines = sorted(columns[center], key=lambda line: line.bbox[1])
        column_text = "\n".join([line.text for line in sorted_lines])
        full_text.append(column_text)

    # Sütunları belirgin bir ayırıcı ile birleştir
    return "\n\n========== SÜTUN SONU ==========\n\n".join(full_text)


# --- ANA İŞ AKIŞI ---
def main():
    """Ana OCR işlem hattını çalıştırır."""
    print("--- Hibrit OCR İşlem Hattı Başlatıldı ---")
    try:
        # Cihazı belirle (GPU varsa kullan, yoksa CPU)
        if torch.cuda.is_available():
            device = torch.device("cuda")
        elif torch.backends.mps.is_available():
            device = torch.device("mps")
        else:
            device = torch.device("cpu")
        print(f"Kullanılacak cihaz: {device}")

        # Supabase istemcisini başlat
        supabase = init_supabase_client()
        if not supabase:
            return

        bucket_name = 'gazette-pdfs'
        print(f"'{bucket_name}' bucket'ındaki dosyalar listeleniyor...")
        all_files = supabase.storage.from_(bucket_name).list()
        
        pdf_files_info = [f for f in all_files if f['name'].lower().endswith('.pdf')]
        print(f"Toplam {len(pdf_files_info)} PDF dosyası bulundu.")

        num_to_sample = min(10, len(pdf_files_info))
        if num_to_sample == 0:
            print("İşlenecek PDF bulunamadı.")
            return
            
        selected_files = random.sample(pdf_files_info, num_to_sample)
        print(f"{num_to_sample} adet rastgele PDF test için seçildi.")

        script_dir = os.path.dirname(os.path.abspath(__file__))
        output_folder = os.path.join(script_dir, "ocr_output")
        os.makedirs(output_folder, exist_ok=True)

        for file_info in selected_files:
            pdf_name = file_info['name']
            print(f"\n--- İşleniyor: {pdf_name} ---")
            
            # Her PDF için özel bir çıktı klasörü oluştur
            pdf_stem = Path(pdf_name).stem
            pdf_output_dir = Path(output_folder) / pdf_stem
            os.makedirs(pdf_output_dir, exist_ok=True)

            pdf_bytes = download_pdf_from_supabase(supabase, bucket_name, pdf_name)
            if not pdf_bytes:
                print(f"❌ Hata: {pdf_name} indirilemedi.")
                continue

            images = pdf_bytes_to_images(pdf_bytes)
            if not images:
                print(f"❌ Hata: {pdf_name} resimlere dönüştürülemedi.")
                continue

            processed_announcements = []
            full_raw_text_for_pdf = []

            # SAYFA SAYFA İŞLEME DÖNGÜSÜ
            for i, image in enumerate(images):
                page_num = i + 1
                print(f"  📖 Sayfa {page_num}/{len(images)} işleniyor...")

                page_image_path = pdf_output_dir / f"page_{page_num}.png"
                image.save(page_image_path, "PNG")

                # OCR işlemini izole bir süreçte çalıştır
                result_queue = Queue()
                ocr_process = Process(target=ocr_process_task, args=(page_image_path, result_queue, ["tr"], device))
                ocr_process.start()
                ocr_process.join(timeout=300) # 5 dakika zaman aşımı

                if ocr_process.is_alive():
                    print(f"    ❌ HATA: Sayfa {page_num} için OCR işlemi zaman aşımına uğradı. Süreç sonlandırılıyor.")
# ... (kalan kod aynı)
                    ocr_process.join()
                    prediction = None
                elif result_queue.empty():
                    print(f"    ❌ HATA: Sayfa {page_num} için OCR süreci çöktü veya sonuç döndürmedi.")
                    prediction = None
                else:
                    prediction = result_queue.get()

                if prediction:
                    page_text = reorder_text_by_columns(prediction.text_lines)
                    full_raw_text_for_pdf.append(page_text)
                    announcements_on_page = parse_structured_text(page_text)
                    for announcement in announcements_on_page:
                        announcement['sayfa_numarasi'] = page_num
                    processed_announcements.extend(announcements_on_page)
                else:
                    print(f"    ⚠️ Sayfa {page_num} işlenemedi, atlanıyor.")

                # Ana süreçte belleği temizle
                del image, prediction
                gc.collect()
            
            print(f"🖼️  Görüntüler şuraya kaydedildi: {pdf_output_dir}")
            
            # Ham metni dosyaya yaz
            raw_text_filepath = pdf_output_dir / "raw_text.txt"
            with open(raw_text_filepath, 'w', encoding='utf-8') as f:
                f.write("\n\n--- SAYFA SONU ---\n\n".join(full_raw_text_for_pdf))
            print(f"📄 Ham metin şuraya kaydedildi: {raw_text_filepath}")

            # Ayrıştırılmış JSON sonucunu dosyaya yaz
            json_output_filepath = pdf_output_dir / "structured_output.json"
            with open(json_output_filepath, 'w', encoding='utf-8') as f:
                json.dump(processed_announcements, f, ensure_ascii=False, indent=4)
            print(f"📄 Yapılandırılmış JSON şuraya kaydedildi: {json_output_filepath}")

            print(f"✅ {pdf_name} başarıyla işlendi ve {len(processed_announcements)} ilan ayrıştırıldı.")

            # --- PDF Sonu Bellek Temizliği ---
            del pdf_bytes, images, processed_announcements, full_raw_text_for_pdf
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()
            print(f"🧹 Bellek bir sonraki PDF için temizlendi.")

        print(f"\nİşlem tamamlandı. Tüm çıktılar '{output_folder}' klasörüne kaydedildi.")

    except Exception as e:
        print(f"Ana işlem sırasında bir hata oluştu: {e}")
    finally:
        print("\n--- Hibrit OCR İşlem Hattı Tamamlandı ---")

if __name__ == "__main__":
    multiprocessing.set_start_method('spawn', force=True)
    main()
