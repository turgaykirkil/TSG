# -*- coding: utf-8 -*-
"""
Ticaret Sicil Gazetesi için Surya ve Tesseract tabanlı hibrit OCR işlem hattı.

Bu betik aşağıdaki adımları uygular:
1. Supabase'den bir PDF dosyası indirir.
2. PDF'i sayfa sayfa resimlere dönüştürür.
3. Surya'yı kullanarak her sayfadaki metin bloklarının düzenini ve okuma sırasını tespit eder.
4. Tesseract'ı kullanarak Surya'nın belirlediği her bir metin bloğunu okur.
5. Sonuçları birleştirerek sayfanın tam metnini oluşturur, ayrıştırır ve yapılandırılmış JSON verileri olarak kaydeder.
"""

import os
from pathlib import Path
import random
import shutil
from PIL import Image
from pdf2image import convert_from_path, convert_from_bytes
import pytesseract

from supabase import create_client, Client
from dotenv import load_dotenv
import json
import time
from functools import wraps
import re
import pprint
import numpy as np
import gc
import torch
import multiprocessing
from multiprocessing import Process, Queue

# .env dosyasının bir üst dizinde olduğunu varsayarak yolu belirtiyoruz.
dotenv_path = os.path.join(os.path.dirname(__file__), '..', '.env')
print(f"INFO: .env dosyası şu yolda aranıyor: {os.path.abspath(dotenv_path)}")
load_dotenv(dotenv_path=dotenv_path)

# --- AYARLAR ---
SUPABASE_URL = os.getenv("TSG_SUPABASE_URL")
SUPABASE_SERVICE_KEY = os.getenv("TSG_SUPABASE_SERVICE_ROLE_KEY")
BUCKET_NAME = "gazette-pdfs"
OUTPUT_DIR = "test_output"
# Tesseract path (eğer sistem PATH'inde değilse belirtin)
# pytesseract.pytesseract.tesseract_cmd = r'/path/to/your/tesseract'

# --- DECORATORS & HELPERS ---
def timer(func):
    """Fonksiyonların çalışma süresini ölçmek için bir decorator."""
    @wraps(func)
    def wrapper(*args, **kwargs):
        start_time = time.time()
        result = func(*args, **kwargs)
        end_time = time.time()
        print(f"✅ {func.__name__} fonksiyonu {end_time - start_time:.2f} saniyede tamamlandı.")
        return result
    return wrapper

def save_results(pdf_name, results):
    """OCR sonuçlarını JSON dosyasına kaydeder."""
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    output_path = os.path.join(OUTPUT_DIR, f"{os.path.splitext(pdf_name)[0]}_hybrid_ocr.json")
    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(results, f, ensure_ascii=False, indent=4)
    print(f"📄 Sonuçlar başarıyla '{output_path}' dosyasına kaydedildi.")

# --- SUPABASE FONKSİYONLARI ---
@timer
def init_supabase_client():
    """Supabase istemcisini başlatır."""
    print("☁️ Supabase istemcisi başlatılıyor...")
    if not SUPABASE_URL or not SUPABASE_SERVICE_KEY:
        print("❌ Hata: SUPABASE_URL ve SUPABASE_SERVICE_KEY .env dosyasında tanımlanmalı.")
        return None
    try:
        supabase: Client = create_client(SUPABASE_URL, SUPABASE_SERVICE_KEY)
        print("☁️ Supabase istemcisi başarıyla başlatıldı.")
        return supabase
    except Exception as e:
        print(f"❌ Hata: Supabase istemcisi başlatılamadı. {e}")
        return None

@timer
def get_latest_pdf_filename(supabase: Client) -> str:
    """Veritabanından en son gazetenin URL'sini alır ve dosya adını çıkarır."""
    print("🔎 En güncel PDF dosyası veritabanından aranıyor...")
    try:
        data, count = supabase.table("announcements").select("pdf_url").order("publication_date", desc=True).limit(1).execute()
        response = data[1] # Actual data is in the second element
        if response:
            pdf_url = response[0]['pdf_url']
            from urllib.parse import urlparse
            clean_url = pdf_url.split('?')[0]
            parsed_url = urlparse(clean_url)
            filename = os.path.basename(parsed_url.path)
            print(f"🔎 İşlenecek dosya adı bulundu: {filename}")
            return filename
        else:
            print("❌ Hata: Veritabanında 'announcements' tablosunda kayıt bulunamadı.")
            return None
    except Exception as e:
        print(f"❌ Hata: En güncel PDF dosyası alınamadı - {e}")
        return None

@timer
def download_pdf_from_supabase(supabase: Client, bucket_name: str, pdf_name: str):
    """Supabase bucket'ından PDF indirir."""
    print(f"📥 '{pdf_name}' dosyası '{bucket_name}' bucket'ından indiriliyor...")
    try:
        pdf_bytes = supabase.storage.from_(bucket_name).download(pdf_name)
        return pdf_bytes
    except Exception as e:
        print(f"❌ Hata: Dosya indirilemedi. {e}")
        return None

# --- OCR FONKSİYONLARI ---
@timer
def pdf_bytes_to_images(pdf_bytes):
    """PDF byte verisini PIL Image nesneleri listesine dönüştürür."""
    # pdf2image kullanarak PDF'i sayfa sayfa görüntülere dönüştür
    # Bellek sorunlarını önlemek için DPI 300'e ayarlandı
    return convert_from_bytes(pdf_bytes, dpi=300) # Yüksek çözünürlük için DPI ayarı

def ocr_process_task(image_path, result_queue, languages, device):
    """Bir alt süreçte çalışacak OCR görevi.
       Model yüklemesini ve OCR işlemini burada yaparak izolasyon sağlar.
    """
    # Alt süreçler ana süreçteki import'ları miras almaz, bu yüzden burada yeniden import edilmelidir.
    from surya.ocr import run_ocr
    from surya.model.detection.segformer import load_model as load_det_model, load_processor as load_det_processor
    from surya.model.recognition.model import load_model as load_rec_model
    from surya.model.recognition.processor import load_processor as load_rec_processor
    from PIL import Image
    import torch
    import gc

    try:
        # Modelleri ve işlemcileri resmi dokümantasyona göre yükle
        det_processor = load_det_processor()
        det_model = load_det_model()
        rec_processor = load_rec_processor()
        rec_model = load_rec_model()

        # Modelleri doğru cihaza taşı
        det_model = det_model.to(device)
        rec_model = rec_model.to(device)

        image = Image.open(image_path).convert("RGB")
        predictions = run_ocr([image], [languages], det_model, det_processor, rec_model, rec_processor)
        result_queue.put(predictions[0])
    except Exception as e:
        print(f"OCR alt sürecinde hata: {e}")
        result_queue.put(None) # Hata durumunda None gönder
    finally:
        # Bellek temizliği
        if 'det_processor' in locals(): del det_processor
        if 'det_model' in locals(): del det_model
        if 'rec_model' in locals(): del rec_model
        if 'rec_processor' in locals(): del rec_processor
        if 'image' in locals(): del image
        if 'predictions' in locals(): del predictions
        if torch.cuda.is_available() or torch.backends.mps.is_available():
            torch.cuda.empty_cache()
        gc.collect()
