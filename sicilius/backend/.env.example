# PostgreSQL Database Configuration
POSTGRES_DB=tsg_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application Settings
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (for development outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tsg_platform

# Redis URL (for development outside Docker)
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# File Upload Settings
UPLOAD_FOLDER=./data/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Task Scheduler Settings
BACKGROUND_TASKS_MAX_WORKERS=10
JOB_TIMEOUT_SECONDS=3600
STUCK_JOB_CHECK_INTERVAL=300
JOB_STUCK_AFTER_SECONDS=1800
MAX_JOB_RETRIES=3
AUTO_RETRY_FAILED_JOBS=true
COMPLETED_JOB_RETENTION_DAYS=30
FAILED_JOB_RETENTION_DAYS=90

# OCR Settings (if applicable)
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata/

# Search (proximity thresholds)
# Adjust if needed; default values shown below
SEARCH_PROXIMITY_STRONG=8
SEARCH_PROXIMITY_MEDIUM=20
SEARCH_PROXIMITY_WEAK=40

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/tsg_platform.log
