# Main site (sicilius.com.tr)
sicilius.com.tr {
    # Backend API
    handle /api/* {
        reverse_proxy backend:5001
    }

    handle /docs {
        reverse_proxy backend:5001
    }

    handle /openapi.json {
        reverse_proxy backend:5001
    }

    # Frontend (Next.js)
    handle {
        reverse_proxy frontend:3000
    }
}

# MinIO Console
minio.sicilius.com.tr {
    reverse_proxy db:9001
}

# MinIO S3 API
s3.sicilius.com.tr {
    reverse_proxy db:9000
}
