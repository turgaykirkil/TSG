# Main site (sicilius.com.tr)
http://sicilius.com.tr, http://www.sicilius.com.tr {
    # Backend API
    handle /api/* {
        reverse_proxy backend:5001
    }

    handle /docs {
        reverse_proxy backend:5001
    }

    handle /openapi.json {
        reverse_proxy backend:5001
    }

    # Presentation page (standalone HTML)
    handle /presentation {
        rewrite * /presentation/index.html
        reverse_proxy frontend:3000
    }

    handle /presentation/ {
        rewrite * /presentation/index.html
        reverse_proxy frontend:3000
    }

    # Frontend (Next.js)
    handle {
        reverse_proxy frontend:3000
    }
}

# MinIO Console
http://minio.sicilius.com.tr {
    reverse_proxy db:9001
}

# MinIO S3 API
http://s3.sicilius.com.tr {
    reverse_proxy db:9000
}
